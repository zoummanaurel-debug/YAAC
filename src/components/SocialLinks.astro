---
<ul class:list={['social', `social--${tone}`]}>
  {socialLinks.map((s) => (
    <li>
      <a href={s.url} target="_blank" rel="noopener" title={s.name}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d={icons[s.name]} />
        </svg>
        <span class="visually-hidden">{s.name}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease),
                transform var(--dur-fast) var(--ease);
  }
  .social a:hover { transform: translateY(-2px); }

  .social--dark a {
    background: color-mix(in srgb, var(--green-300) 14%, transparent);
    color: var(--green-100);
  }
  .social--dark a:hover { background: var(--yaac-accent); color: var(--green-950); }

  .social--light a { background: var(--green-100); color: var(--green-800); }
  .social--light a:hover { background: var(--yaac-primary); color: var(--white); }

  @media (prefers-reduced-motion: reduce) {
    .social a:hover { transform: none; }
  }
</style>
