---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContactForm from '../ContactForm.astro';
import { useTranslations, localePath, formatDate, type Lang } from '../../i18n/utils';

interface Props { entry: CollectionEntry<'news'>; lang: Lang }
const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const { title, description, date, category, cover, coverAlt } = entry.data;
---
<Base lang={lang} routeKey="news" title={title} description={description}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={date.toISOString()} />
  </Fragment>

  <article class="post">
    <header class="post__header">
      <div class="container container--narrow">
        <a class="post__back" href={localePath(lang, 'news')}>← {t.news.backToNews}</a>
        <p class="post__cat">{t.news.categories[category]}</p>
        <h1 class="post__title">{title}</h1>
        <p class="post__meta">
          {t.news.publishedOn}
          <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, lang)}</time>
        </p>
      </div>
    </header>

    <div class="container post__cover">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[640, 1024, 1600]}
        sizes="(min-width: 1200px) 1100px, 100vw"
        loading="eager"
      />
    </div>

    <div class="container container--narrow post__body">
      <Content />
    </div>
  </article>

  <ContactForm lang={lang} />
</Base>

<style>
  .post__header { padding-block: var(--space-8) var(--space-6); background: var(--bg-subtle); }

  .post__back {
    display: inline-block;
    margin-bottom: var(--space-5);
    font-weight: 600;
    text-decoration: none;
  }
  .post__back:hover { text-decoration: underline; }

  .post__cat {
    display: inline-block;
    padding: var(--space-1) var(--space-4);
    background: var(--yaac-primary);
    color: var(--white);
    border-radius: var(--radius-full);
    font-size: var(--step--1);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }
  .post__title { margin-bottom: var(--space-4); }
  .post__meta { color: var(--text-muted); font-size: var(--step--1); }

  .post__cover { margin-top: calc(var(--space-7) * -1); }
  .post__cover :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  /* Mesure de lecture confortable : ~68 caractères par ligne */
  .post__body { padding-block: var(--space-8); font-size: var(--step-1); }
  .post__body :global(> * + *) { margin-top: var(--space-5); }
  .post__body :global(h2) { font-size: var(--step-3); margin-top: var(--space-8); }
  .post__body :global(h3) { font-size: var(--step-2); margin-top: var(--space-6); }
  .post__body :global(ul), .post__body :global(ol) { padding-left: var(--space-6); }
  .post__body :global(li + li) { margin-top: var(--space-3); }
  .post__body :global(strong) { color: var(--green-900); }
  .post__body :global(em) { color: var(--text-muted); }

  .post__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step-0);
  }
  .post__body :global(td), .post__body :global(th) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
  .post__body :global(blockquote) {
    padding-left: var(--space-5);
    border-left: 3px solid var(--yaac-accent);
    color: var(--text-muted);
    font-style: italic;
  }
</style>
