---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { useTranslations, localePath, formatDate, type Lang } from '../../i18n/utils';

interface Props { entry: CollectionEntry<'news'>; lang: Lang }
const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const { title, description, date, category, cover, coverAlt, video } = entry.data;

// L'id vaut "<lang>/<slug>" ; le slug est le même dans les deux langues.
const slug = entry.id.split('/').pop()!;
---
<Base lang={lang} routeKey="news" title={title} description={description} articleSlug={slug}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={date.toISOString()} />
  </Fragment>

  <article class="post">
    <header class="post__header">
      <div class="container container--narrow">
        {/* Le lien de retour et la catégorie étaient deux `inline-block`
            successifs : ils se retrouvaient sur la même ligne, séparés par la
            seule espace du code source. Une rangée flex leur donne un écart
            réel et les fait passer à la ligne quand la place manque. */}
        <div class="post__top">
          <a class="post__back" href={localePath(lang, 'news')}>← {t.news.backToNews}</a>
          <p class="post__cat">{t.news.categories[category]}</p>
        </div>
        <h1 class="post__title">{title}</h1>
        <p class="post__meta">
          {t.news.publishedOn}
          <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, lang)}</time>
        </p>
      </div>
    </header>

    <div class="container post__cover">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[640, 1024, 1600]}
        sizes="(min-width: 1200px) 1100px, 100vw"
        loading="eager"
      />
    </div>

    {video && (
      <div class="container container--narrow post__video">
        <h2 class="post__video-title">{t.news.watchVideo}</h2>
        <div class="post__video-frame">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${video}?rel=0`}
            title={title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    )}

    <div class="container container--narrow post__body">
      <Content />
    </div>
  </article>
</Base>

<style>
  /* Le rembourrage bas doit rester SUPÉRIEUR au recouvrement de l'image
     ci-dessous, sinon la date de publication passe sous la photo. */
  .post__header { padding-block: var(--space-8) var(--space-8); background: var(--bg-subtle); }

  .post__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-5);
  }

  .post__back {
    /* Rembourrage vertical et retrait latéral compensé : la cible tactile
       grandit sans que le texte se décale de la marge. */
    padding-block: var(--space-2);
    padding-inline: var(--space-2);
    margin-inline-start: calc(var(--space-2) * -1);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .post__back:hover { text-decoration: underline; }

  .post__cat {
    padding: var(--space-2) var(--space-4);
    background: var(--yaac-primary);
    color: var(--white);
    border-radius: var(--radius-full);
    font-size: var(--step--1);
    font-weight: 600;
    margin: 0;
  }
  .post__title { margin-bottom: var(--space-4); }
  .post__meta { color: var(--text-muted); font-size: var(--step--1); }

  /* Le recouvrement est un geste de mise en page qui suppose de la place.
     Sur téléphone, un titre sur quatre lignes ne laisse rien à recouvrir :
     l'image se contente de suivre. */
  .post__cover { margin-top: var(--space-5); }
  @media (min-width: 720px) {
    .post__cover { margin-top: calc(var(--space-7) * -1); }
  }
  .post__cover :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .post__video { padding-top: var(--space-8); }
  .post__video-title { font-size: var(--step-2); margin-bottom: var(--space-4); }
  .post__video-frame {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background: var(--green-950);
  }
  .post__video-frame iframe { width: 100%; height: 100%; border: 0; display: block; }

  /* Mesure de lecture confortable : ~68 caractères par ligne */
  .post__body { padding-block: var(--space-8); font-size: var(--step-1); }
  .post__body :global(> * + *) { margin-top: var(--space-5); }
  .post__body :global(h2) { font-size: var(--step-3); margin-top: var(--space-8); }
  .post__body :global(h3) { font-size: var(--step-2); margin-top: var(--space-6); }
  .post__body :global(ul), .post__body :global(ol) { padding-left: var(--space-6); }
  .post__body :global(li + li) { margin-top: var(--space-3); }
  .post__body :global(strong) { color: var(--green-900); }
  .post__body :global(em) { color: var(--text-muted); }

  .post__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step-0);
  }
  .post__body :global(td), .post__body :global(th) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
  /* La citation se distingue par sa mise en page — retrait, corps plus grand,
     italique — et non par une barre verte collée à gauche. */
  .post__body :global(blockquote) {
    margin-inline: 0;
    padding-block: var(--space-4);
    border-block: 1px solid var(--border);
    font-family: var(--font-heading);
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    font-style: italic;
    color: var(--green-800);
  }
</style>
