---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../Hero.astro';
import StatsBand from '../StatsBand.astro';
import TestimonialCarousel from '../TestimonialCarousel.astro';
import NewsCard from '../NewsCard.astro';
import CtaBand from '../CtaBand.astro';
import heroImage from '../../assets/photos/hero.jpg';
import { useTranslations, localePath, type Lang } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = await getCollection('news', ({ id }) => id.startsWith(`${lang}/`));
const byDate = (a: typeof posts[number], b: typeof posts[number]) =>
  b.data.date.getTime() - a.data.date.getTime();

// Les articles marqués `featured` sont ceux mis en avant sur yaac.network.
// La plupart partagent la même date de publication : sans ce drapeau, l'ordre
// des 4 vedettes dépendrait d'un tri instable.
const featured = posts.filter((p) => p.data.featured).sort(byDate);
const latest = (featured.length >= 4 ? featured : [...posts].sort(byDate)).slice(0, 4);
---
<Base lang={lang} routeKey="home">
  <Hero
    homeTitle
    title={t.home.heroTitle}
    lead={t.home.heroLead}
    image={heroImage}
    imageAlt={t.meta.fullName}
  >
    <a class="btn btn--accent" href={localePath(lang, 'join')}>
      {t.home.heroCta}
    </a>
    <a class="btn btn--outline hero-alt" href={localePath(lang, 'about')}>
      {t.home.heroCtaAlt}
    </a>
  </Hero>

  <StatsBand title={t.home.statsTitle} stats={t.home.stats} />

  <TestimonialCarousel
    lang={lang}
    title={t.home.testimonialsTitle}
    lead={t.home.testimonialsLead}
  />

  <section class="section section--tint">
    <div class="container">
      <div class="news-head">
        <div>
          <h2>{t.home.newsTitle}</h2>
        </div>
        <a class="btn btn--outline" href={localePath(lang, 'news')}>{t.home.newsAll}</a>
      </div>

      <div class="news-grid">
        {latest.map((entry, i) => (
          <NewsCard entry={entry} lang={lang} wide={i === 0} />
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title={t.home.ctaTitle}
    lead={t.home.ctaLead}
    ctaLabel={t.home.ctaButton}
    ctaHref={localePath(lang, 'join')}
  />

  <section class="section contact-teaser">
    <div class="container container--narrow">
      <h2>{t.home.contactTeaser}</h2>
      <a class="btn btn--primary" href={localePath(lang, 'contact')}>{t.home.contactCta}</a>
    </div>
  </section>
</Base>

<style>
  .hero-alt { border-color: var(--white); color: var(--white); }
  .hero-alt:hover { background: var(--white); color: var(--green-900); }

  .news-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .news-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .contact-teaser { text-align: center; }
  .contact-teaser h2 { font-size: var(--step-3); margin-bottom: var(--space-5); }
</style>
