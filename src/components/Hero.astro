---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  lead: string;
  image: ImageMetadata;
  imageAlt: string;
  /** Hauteur réduite pour les pages intérieures. */
  compact?: boolean;
  /** Slogan d'accueil : tenu sur une seule ligne sur grand écran. */
  homeTitle?: boolean;
}

const { title, lead, image, imageAlt, compact = false, homeTitle = false } = Astro.props;
---
<section class:list={['hero', { 'hero--compact': compact, 'hero--home': homeTitle }]}>
  <Image
    class="hero__bg"
    src={image}
    alt={imageAlt}
    {/* Ne jamais demander plus large que la source (1600 px) : Astro ne
        peut pas agrandir et réémet alors l'original non optimisé. */}
    widths={[640, 1024, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="container hero__inner">
    <h1 class:list={['hero__title', { 'hero__title--home': homeTitle }]}>{title}</h1>
    <p class="hero__lead">{lead}</p>
    <div class="hero__actions"><slot /></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    isolation: isolate;
    min-height: clamp(30rem, 26rem + 22vw, 44rem);
    align-items: center;
    overflow: hidden;
  }
  .hero--compact { min-height: clamp(20rem, 17rem + 14vw, 28rem); }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Voile dégradé : garantit le contraste du texte quelle que soit la photo.
     Sans lui, le blanc sur photo claire tombe sous le seuil WCAG. */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg,
        color-mix(in srgb, var(--green-950) 62%, transparent) 0%,
        color-mix(in srgb, var(--green-950) 74%, transparent) 100%),
      linear-gradient(100deg,
        color-mix(in srgb, var(--green-900) 55%, transparent) 0%,
        transparent 65%);
  }

  .hero__inner {
    padding-block: var(--space-9);
    max-width: 62ch;
  }
  /* Le slogan doit tenir sur une seule ligne. Il fait ~41 caracteres en
     francais, donc au-dela de 1100px on elargit le bloc et on empeche le
     retour a la ligne. En dessous, il se replie normalement. */
  .hero--home .hero__inner { max-width: none; }

  .hero__title--home { font-size: clamp(1.9rem, 1rem + 3.4vw, 3.4rem); }
  @media (min-width: 1100px) {
    .hero__title--home { white-space: nowrap; }
  }

  .hero__title {
    color: var(--white);
    margin-bottom: var(--space-5);
    text-shadow: 0 2px 20px rgb(8 24 15 / 0.4);
  }
  .hero__lead {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--green-100);
    max-width: 54ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .hero__actions:empty { display: none; }
</style>
